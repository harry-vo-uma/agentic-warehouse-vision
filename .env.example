# Point at NVIDIA's hosted API...
NVIDIA_API_KEY=nvapi-...
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ...or at a locally hosted NIM container:
# NIM_BASE_URL=http://localhost:8000/v1

NIM_VLM_MODEL=nvidia/vila
NIM_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Force the deterministic offline backend even when a key is present.
# The eval harness sets this so results are reproducible.
AWVI_FORCE_MOCK=0

# auto | deepstream | synthetic
AWVI_PERCEPTION_BACKEND=auto

# Escalation thresholds (see eval/ablations.py for the sweep)
AWVI_SUPPRESS_BELOW=0.36
AWVI_ESCALATE_ABOVE=0.68
AWVI_PAGE_ABOVE=0.86
